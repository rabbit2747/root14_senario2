    "title": "Orion Echo Enterprise APT Range",
    "subtitle": "Supply Chain Attack Curriculum",
    "audience": "cybersecurity undergraduate / junior analyst",
    "difficulty": "intermediate",
    "estimatedMinutes": 180,
    "canonicalStatus": "working-canonical"
  },
  "story": {
    "vendor": "Orion Echo Systems",
    "customer": "ANRC",
    "product": "EchoAgent",
    "incident": "ANRC observed abnormal behavior after a trusted EchoAgent update.",
    "coreMessage": "The attacker reaches the customer by abusing the vendor supply chain, not by directly breaching the customer network."
  },
  "sessions": [
    {
      "id": "mission-briefing",
      "label": "Mission Briefing",
      "purpose": "Set incident context, learner role, and final investigation goal."
    },
    {
      "id": "legacy-3d-overview",
      "label": "Legacy 3D Overview",
      "purpose": "Experience the original ROOT14 3D flow before detailed explanation."
    },
    {
      "id": "concept-class",
      "label": "Concept Class",
      "purpose": "Teach supply chain, trust, token, CI/CD, signing, update channel, and evidence concepts on an infrastructure map."
    },
    {
      "id": "practical-case-review",
      "label": "Practical Case Review",
      "purpose": "Reconnect concepts to the Orion Echo incident and evidence plan."
    },
    {
      "id": "practical-3d",
      "label": "Practical 3D",
      "purpose": "Use the MVP topology to understand which systems and boundaries each stage touches."
    },
    {
      "id": "hands-on-lab",
      "label": "Hands-on Lab",
      "purpose": "Run the Docker lab and collect concrete command output, logs, metadata, and artifacts."
    },
    {
      "id": "dark-web-impact",
      "label": "Dark Web Impact",
      "purpose": "Confirm the final business impact by following customer export data to the external leak point."
    }
  ],
