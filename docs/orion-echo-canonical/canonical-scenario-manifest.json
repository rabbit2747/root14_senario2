  "canonicalDecisions": {
    "c2Emulator": "Archive/compatibility only. The target teaching flow should explain direct foothold-based internal discovery unless the lab still requires the emulator.",
    "flags": "Allowed only as hidden progress markers. Student-facing curriculum should call them evidence or checkpoints.",
    "darkWebExfiltration": "Canonical final stage. Defender Report is not the scenario ending; it can remain only as an optional after-action activity.",
