  "canonicalDecisions": {
    "scenarioMode": "Defensive investigation only. Students inspect simulated evidence and do not execute phishing.",
    "phishingInfrastructure": "Static screenshots, sanitized messages, and reserved domains only.",
    "paymentRails": "Fictional payment records only. No real bank names or accounts.",
    "finalOutput": "Final output is an executive investigation report with findings, timeline, root cause, impact, and recommendations.",
