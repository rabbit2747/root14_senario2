  "glossary": {
    "spearphishing": {
      "term": "Spearphishing",
      "fullName": "Spearphishing Attachment / Link",
      "analogy": "\ud83c\udfaf \ub9de\ucda4\ud615 \ub099\uc2dc \uba54\uc77c",
      "easyDesc": "\ubd88\ud2b9\uc815 \ub2e4\uc218\uc5d0\uac8c \ubcf4\ub0b4\ub294 \uc2a4\ud338 \uba54\uc77c\uacfc \ub2ec\ub9ac, \ud2b9\uc815 \uc9c1\uc6d0\uc758 \uc774\ub984\u00b7\uc9c1\ucc45\u00b7\uc5c5\ubb34 \ub0b4\uc6a9\uc744 \uc815\ud655\ud788 \ub123\uc5b4 '\uc9c4\uc9dc\ucc98\ub7fc' \ubcf4\uc774\ub294 \uac00\uc9dc \uba54\uc77c\uc744 \ubcf4\ub0b4\ub294 \uacf5\uaca9\uc785\ub2c8\ub2e4.",
      "techDesc": "\uc0ac\uc804 \uc815\ucc30(Reconnaissance) \ub2e8\uacc4\uc5d0\uc11c \uc218\uc9d1\ud55c \uc784\uc9c1\uc6d0 \uc815\ubcf4\ub97c \ud65c\uc6a9\ud558\uc5ec, \ud2b9\uc815 \uc778\ubb3c\uc744 \ub300\uc0c1\uc73c\ub85c \uc545\uc131 \ucca8\ubd80\ud30c\uc77c \ub610\ub294 \ub9c1\ud06c\ub97c \ud3ec\ud568\ud55c \uc774\uba54\uc77c\uc744 \uc804\uc1a1\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ud074\ub9ad\ud558\uba74 \ub9e4\ud06c\ub85c/\uc775\uc2a4\ud50c\ub85c\uc787\uc774 \uc2e4\ud589\ub429\ub2c8\ub2e4."
    },
    "valid_accounts": {
      "term": "Valid Accounts",
      "fullName": "Valid Accounts (T1078)",
      "analogy": "\ud83d\udd11 \ud6d4\uce5c \uc9c4\uc9dc \uc5f4\uc1e0",
      "easyDesc": "\ub3c4\ub451\uc774 \ubb38\uc744 \ubd80\uc218\uc9c0 \uc54a\uace0, \uacbd\ube44\uc6d0\uc758 \uc9c4\uc9dc \uc5f4\uc1e0\ub97c \ud6d4\uccd0\uc11c \ub2f9\ub2f9\ud558\uac8c \uc815\ubb38\uc73c\ub85c \ub4e4\uc5b4\uc624\ub294 \uac83\uc785\ub2c8\ub2e4. \ubcf4\uc548 \uc2dc\uc2a4\ud15c\uc774 \ud0d0\uc9c0\ud558\uae30 \uac00\uc7a5 \uc5b4\ub824\uc6b4 \ubc29\ubc95\uc785\ub2c8\ub2e4.",
      "techDesc": "\ub2e4\ud06c\uc6f9 \uc720\ucd9c, \ud06c\ub808\ub374\uc15c \uc2a4\ud130\ud551, \ud328\uc2a4\uc6cc\ub4dc \uc2a4\ud504\ub808\uc774 \ub4f1\uc73c\ub85c \ud68d\ub4dd\ud55c \uc2e4\uc81c \uacc4\uc815 \uc815\ubcf4\ub85c \ub85c\uadf8\uc778\ud569\ub2c8\ub2e4. \uc815\uc0c1 \uc778\uc99d\uc774\ubbc0\ub85c IDS/SIEM\uc774 \uc545\uc131 \ud65c\ub3d9\uc73c\ub85c \ubd84\ub958\ud558\uc9c0 \ubabb\ud569\ub2c8\ub2e4."
    },
    "domain_accounts": {
      "term": "Domain Accounts",
      "fullName": "Valid Accounts: Domain Accounts (T1078.002)",
      "analogy": "\ud83c\udfe2 \ud68c\uc0ac \uc0ac\uc6d0\uc99d\uc73c\ub85c \uc804\uccb4 \uac74\ubb3c \uc790\uc720 \ucd9c\uc785",
      "easyDesc": "Active Directory\uc758 \ub3c4\uba54\uc778 \uacc4\uc815\uc744 \ud0c8\ucde8\ud558\uba74 \ud574\ub2f9 \ub3c4\uba54\uc778\uc5d0 \uc18d\ud55c \ubaa8\ub4e0 \uc2dc\uc2a4\ud15c\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub9c8\uce58 \ub9c8\uc2a4\ud130\ud0a4\uc640 \uac19\uc2b5\ub2c8\ub2e4.",
      "techDesc": "Active Directory \ub3c4\uba54\uc778 \uacc4\uc815(e.g. svc_backup, admin_tier1)\uc744 \ud0c8\ucde8\ud558\uc5ec Kerberos TGT\ub97c \ubc1c\uae09\ubc1b\uace0, \ub3c4\uba54\uc778 \ub0b4 \uc804\uccb4 \uc2dc\uc2a4\ud15c\uc5d0 \ub300\ud55c \uc778\uc99d\ub41c \uc811\uadfc \uad8c\ud55c\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4."
    },
    "exploit_public": {
      "term": "Exploit Public App",
      "fullName": "Exploit Public-Facing Application (T1190)",
      "analogy": "\ud83d\udeaa \uac74\ubb3c \ub4a4\ucabd \uace0\uc7a5\ub09c \ubb38\uc73c\ub85c \uce68\uc785",
      "easyDesc": "\uc6f9\uc0ac\uc774\ud2b8, VPN, \uc774\uba54\uc77c \uc11c\ubc84 \ub4f1 \uc778\ud130\ub137\uc5d0 \uacf5\uac1c\ub41c \uc2dc\uc2a4\ud15c\uc758 \uc54c\ub824\uc9c4 \ucde8\uc57d\uc810(CVE)\uc744 \uc774\uc6a9\ud574 \uc9c1\uc811 \uce68\ud22c\ud569\ub2c8\ub2e4.",
      "techDesc": "\uacf5\uac1c \uc11c\ube44\uc2a4\uc758 \uc54c\ub824\uc9c4 CVE \ucde8\uc57d\uc810(e.g. Log4Shell, ProxyShell)\uc744 \uc775\uc2a4\ud50c\ub85c\uc787\ud558\uc5ec \uc6d0\uaca9 \ucf54\ub4dc \uc2e4\ud589(RCE)\uc744 \ud68d\ub4dd\ud558\uace0, \ucd08\uae30 \ubc1c\ud310(foothold)\uc744 \ud655\ubcf4\ud569\ub2c8\ub2e4."
    },
    "supply_chain": {
      "term": "Supply Chain",
      "fullName": "Supply Chain Compromise (T1195)",
      "analogy": "\ud83d\udce6 \ud0dd\ubc30 \uc0c1\uc790\uc5d0 \ub3c5\uc744 \ub123\ub294 \uac83",
      "easyDesc": "\ud68c\uc0ac\uac00 \uc0ac\uc6a9\ud558\ub294 \uc678\ubd80 \uc18c\ud504\ud2b8\uc6e8\uc5b4\ub098 \uc5c5\ub370\uc774\ud2b8 \ubc30\ud3ec \uacbd\ub85c\ub97c \ubbf8\ub9ac \uac10\uc5fc\uc2dc\ucf1c\ub193\uc73c\uba74, \uc2e0\ub8b0\ud558\uace0 \uc124\uce58\ud55c \uc18c\ud504\ud2b8\uc6e8\uc5b4\uac00 \ub3c5\uc774 \ub429\ub2c8\ub2e4.",
      "techDesc": "\uc8fc\ub85c \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uacf5\uae09\ub9dd(CI/CD \ud30c\uc774\ud504\ub77c\uc778, \uc5c5\ub370\uc774\ud2b8 \uc11c\ubc84)\uc744 \uce68\ud574\ud558\uc5ec \uc815\uc0c1 \uc18c\ud504\ud2b8\uc6e8\uc5b4\uc5d0 \ubc31\ub3c4\uc5b4\ub97c \uc8fc\uc785\ud569\ub2c8\ub2e4. SolarWinds Orion \uacf5\uaca9\uc774 \ub300\ud45c\uc801\uc778 \uc608\uc2dc\uc785\ub2c8\ub2e4."
    }
  },

