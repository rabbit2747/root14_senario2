      "mitre": ["T1046"],
      "evidence": ["discovered service list", "network boundary notes"],
      "practical3dStage": "stage-3-internal-discovery"
    },
    {
      "id": "lab-stage-5-evidence-collection",
      "internalGradingId": "grading_5_evidence_collection",
      "phase": "attack-chain",
      "title": "Wiki, Ticket, and Repo Evidence Collection",
      "objective": "Find valid build-token evidence while separating real clues from decoys and noise.",
      "systems": ["wiki", "ticket-service", "source-repo"],
      "mitre": ["T1213", "T1213.003", "T1552"],
      "evidence": ["release runbook", "OES-1287 ticket", "release pipeline file"],
      "practical3dStage": "stage-4-internal-collection"
    },
    {
      "id": "lab-stage-6-build-token-use",
      "internalGradingId": "grading_6_build_token_use",
      "phase": "attack-chain",
      "title": "Build Token Use",
