      "mitre": ["T1071.001"],
      "evidence": ["beacon registration response", "c2 audit event"],
      "practical3dStage": "stage-2-foothold-c2"
    },
    {
      "id": "lab-stage-4-internal-discovery",
      "internalGradingId": "grading_4_internal_discovery",
      "phase": "attack-chain",
