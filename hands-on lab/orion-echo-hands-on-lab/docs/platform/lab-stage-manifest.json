      "mitre": ["T1550.001"],
      "evidence": ["HTTP 202 build response", "build_request_proof"],
      "practical3dStage": "stage-5-build-token-use"
    },
    {
      "id": "lab-stage-7-artifact-build",
      "internalGradingId": "grading_7_artifact_build",
      "phase": "attack-chain",
      "title": "Artifact Build",
      "objective": "Inspect the benign artifact metadata and marker generated by the build system.",
      "systems": ["build-server"],
      "mitre": ["T1608"],
      "evidence": ["artifact id", "artifact hash", "LAB_BUILD_MARKER"],
      "practical3dStage": "stage-5-build-token-use"
    },
    {
      "id": "lab-stage-8-sign-publish",
      "internalGradingId": "grading_8_supply_chain_publish",
      "phase": "attack-chain",
      "title": "Sign and Publish to ANRC Channel",
      "objective": "Sign the manifest and publish it into the trusted ANRC update channel.",
      "systems": ["build-server", "signing-service", "update-server"],
      "mitre": ["T1195.002", "T1072"],
      "evidence": ["signed manifest", "ANRC channel manifest", "release manifest audit event"],
      "practical3dStage": "stage-6-sign-publish"
    },
    {
      "id": "lab-stage-9-customer-update",
      "internalGradingId": "grading_9_customer_update",
      "phase": "attack-chain",
      "title": "Customer Trusted Update",
      "objective": "Confirm that the ANRC customer app trusts and applies the update through the vendor channel.",
      "systems": ["customer-app", "customer-api", "update-server", "signing-service"],
      "mitre": ["T1072", "T1105", "T1570"],
      "evidence": ["customer poll response", "customer metadata", "customer.update.applied event"],
      "practical3dStage": "stage-7-customer-update"
    },
    {
      "id": "lab-stage-10-export-object",
      "internalGradingId": "grading_11_final_object_access",
      "internalGradingIds": ["grading_10_customer_discovery", "grading_11_final_object_access"],
      "phase": "attack-chain",
      "title": "Customer Export and Final Object",
      "objective": "Discover the relevant ANRC export and retrieve the final object through the modeled customer path.",
      "systems": ["customer-api", "object-store"],
      "mitre": ["T1213", "T1530"],
      "evidence": ["export detail", "discovery_proof", "presigned URL", "final object text", "object_access_proof"],
      "practical3dStage": "stage-8-customer-collection"
    },
    {
      "id": "lab-stage-11-dark-web-exfiltration",
      "internalGradingId": "grading_12_controlled_drop",
      "phase": "evidence",
      "title": "Customer Data Exfiltration To Dark Web",
      "objective": "Drop the recovered ANRC export file into the controlled simulator and confirm that the supervisor bot validates the correct file.",
      "systems": ["customer-api", "object-store", "dark-web-drop"],
      "mitre": ["T1213", "T1530", "T1041"],
      "evidence": ["export detail", "object access proof", "dropped file", "supervisor verdict", "dark-web drop record"],
      "practical3dStage": "stage-10-darkweb-exfiltration"
    }
