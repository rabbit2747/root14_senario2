      "systems": ["edge-proxy", "public-site", "public-docs"],
      "mitre": ["T1591", "T1592.002"],
      "evidence": ["public route response", "service build info", "release channel reference"],
      "practical3dStage": "stage-0-recon"
    },
    {
      "id": "lab-stage-1-initial-access",
      "internalGradingId": "grading_1_initial_access",
