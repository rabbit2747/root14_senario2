      "systems": ["support-portal"],
      "mitre": ["T1190", "T1059.004"],
      "evidence": ["49 arithmetic render", "post exploit marker", "support preview audit event"],
      "practical3dStage": "stage-1-initial-access"
    },
    {
      "id": "lab-stage-2-foothold",
      "internalGradingId": "grading_2_foothold_orientation",
