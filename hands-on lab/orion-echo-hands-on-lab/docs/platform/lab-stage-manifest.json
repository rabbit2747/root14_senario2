      "mitre": ["T1082", "T1083"],
      "evidence": ["id output", "hostname output", "stage2 marker"],
      "practical3dStage": "stage-2-foothold-c2"
    },
    {
      "id": "lab-stage-3-safe-c2",
      "internalGradingId": "grading_3_c2_registration",
